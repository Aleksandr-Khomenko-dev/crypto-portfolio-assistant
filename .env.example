CPDA_APP_NAME=Portfolio Signal Agent
CPDA_ENVIRONMENT=development
CPDA_DEBUG=false
CPDA_TIMEZONE=Europe/Brussels
CPDA_API_PREFIX=/api
CPDA_DEFAULT_QUOTE_CURRENCY=USD

CPDA_DATABASE_URL=sqlite:///./dev.db

# Binance first = spot lastPrice closer to exchanges; CoinGecko fills alts not on Binance.
CPDA_MARKET_PROVIDER_ORDER=binance,coingecko
CPDA_COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
CPDA_COINGECKO_DEMO_API_KEY=
CPDA_BINANCE_BASE_URL=https://api.binance.com
CPDA_HTTP_TIMEOUT_SECONDS=20

CPDA_TELEGRAM_BOT_TOKEN=
CPDA_TELEGRAM_POLLING_ENABLED=false

CPDA_SCHEDULER_ENABLED=true
# How often the scheduler evaluates signals and Telegram alerts (lower = faster alerts).
CPDA_MONITORING_INTERVAL_MINUTES=5
CPDA_MORNING_DIGEST_HOUR=8
CPDA_MORNING_DIGEST_MINUTE=0
CPDA_PRICE_SNAPSHOT_RETENTION_DAYS=30
CPDA_QUOTE_CACHE_TTL_SECONDS=60

CPDA_ABNORMAL_RISE_1H_LOW_PCT=6
CPDA_ABNORMAL_RISE_1H_MEDIUM_PCT=10
CPDA_ABNORMAL_RISE_1H_HIGH_PCT=15
CPDA_ABNORMAL_RISE_4H_LOW_PCT=10
CPDA_ABNORMAL_RISE_4H_MEDIUM_PCT=16
CPDA_ABNORMAL_RISE_4H_HIGH_PCT=24
CPDA_ABNORMAL_RISE_24H_LOW_PCT=12
CPDA_ABNORMAL_RISE_24H_MEDIUM_PCT=20
CPDA_ABNORMAL_RISE_24H_HIGH_PCT=35

CPDA_ABNORMAL_DROP_1H_LOW_PCT=5
CPDA_ABNORMAL_DROP_1H_MEDIUM_PCT=8
CPDA_ABNORMAL_DROP_1H_HIGH_PCT=12
CPDA_ABNORMAL_DROP_4H_LOW_PCT=8
CPDA_ABNORMAL_DROP_4H_MEDIUM_PCT=14
CPDA_ABNORMAL_DROP_4H_HIGH_PCT=20
CPDA_ABNORMAL_DROP_24H_LOW_PCT=10
CPDA_ABNORMAL_DROP_24H_MEDIUM_PCT=18
CPDA_ABNORMAL_DROP_24H_HIGH_PCT=28

CPDA_MAIN_DRAWDOWN_ALERT_PCT=14
CPDA_LONG_TERM_DRAWDOWN_ALERT_PCT=10
CPDA_MAIN_CONCENTRATION_ALERT_PCT=45
CPDA_LONG_TERM_CONCENTRATION_ALERT_PCT=35
CPDA_HIGH_VOLATILITY_24H_PCT=18
CPDA_HIGH_VOLATILITY_4H_PCT=12
CPDA_MIN_POSITION_WEIGHT_PCT=3

CPDA_ABNORMAL_RISE_15M_PCT=5
CPDA_EXTREME_PUMP_1H_PCT=15
CPDA_EXTREME_PUMP_4H_PCT=30
CPDA_EXTREME_PUMP_24H_PCT=40

CPDA_PULLBACK_HEALTHY_PCT=8
CPDA_PULLBACK_CAUTION_PCT=12
CPDA_PULLBACK_WEAK_PCT=20
CPDA_PULLBACK_LOOKBACK_HOURS=48

CPDA_SIGNAL_COOLDOWN_MINUTES=240
CPDA_RISK_COOLDOWN_MINUTES=720
CPDA_TAKE_PROFIT_COOLDOWN_DAYS=14

CPDA_MAIN_TAKE_PROFIT_STAGES=30:10-15,50:15-20,100:20-25
CPDA_LONG_TERM_TAKE_PROFIT_STAGES=75:5-10,125:10-15,200:15-20

# --- Docker Compose (PostgreSQL) — для VPS: задай сильный пароль в shell перед up ---
# export POSTGRES_PASSWORD=...
# POSTGRES_USER=portfolio_user
# POSTGRES_DB=portfolio_db
# POSTGRES_PORT=5432
# Локально с Docker: в .env можно оставить sqlite; compose переопределит CPDA_DATABASE_URL для контейнера api.

# --- Public futures scanner: no exchange keys, no execution ---
# Whitelist/blacklist are comma-separated full symbols. Blacklist always wins.
# TOP_N=0 disables top-N selection; MAX_MARKETS remains a hard cap.
# Scores are model confluence points, never success probabilities.
CPDA_SCANNER_ENABLED=true
CPDA_SCANNER_INTERVAL_MINUTES=5
CPDA_SCANNER_TOP_N=100
CPDA_SCANNER_MAX_MARKETS=100
CPDA_SCANNER_MIN_QUOTE_VOLUME_USD=10000000
CPDA_SCANNER_BLACKLIST=
CPDA_SCANNER_WHITELIST=
CPDA_SCANNER_EXCLUDE_LEVERAGED=true
CPDA_SCANNER_CONCURRENCY=5
CPDA_SCANNER_REQUESTS_PER_SECOND=4.0
CPDA_SCANNER_HTTP_RETRIES=3
CPDA_SCANNER_CANDLE_LIMIT=300
CPDA_SCANNER_UNIVERSE_CACHE_SECONDS=300
CPDA_SCANNER_DATA_GRACE_SECONDS=5
# Scanner exchange: bingx (default) or binance. One run never mixes exchanges.
CPDA_SCANNER_PROVIDER=bingx
# BingX public market data needs no API key (verified 2026-09-23).
CPDA_BINGX_BASE_URL=https://open-api.bingx.com
CPDA_BINGX_REQUESTS_PER_WINDOW=250
CPDA_BINGX_RATE_WINDOW_SECONDS=10
# Self-recorded OI for exchanges without public OI history (BingX): a live observation
# is stored for a 15m close boundary only if taken within this many seconds of it.
CPDA_OI_SNAPSHOT_TOLERANCE_SECONDS=150
CPDA_OI_SNAPSHOT_RETENTION_DAYS=14
# Clock-aligned OI collector (BingX): samples the scanner universe at :00/:15/:30/:45,
# separately from the technical scan, through the same BingX rate limiter.
CPDA_OI_COLLECTION_ENABLED=true
# --- News context (CONTEXT ONLY: never changes scores, thresholds or alert rules) ---
CPDA_NEWS_ENABLED=true
CPDA_NEWS_SEND_TELEGRAM=true
# Free sources have no push delivery; they are polled at a fair-use cadence.
CPDA_NEWS_POLL_BINGX_SECONDS=30
CPDA_NEWS_POLL_RSS_SECONDS=60
# SEC requires a descriptive User-Agent with a contact YOU choose; unset = SEC disabled.
CPDA_NEWS_SEC_USER_AGENT=
CPDA_NEWS_ALERT_MAX_AGE_MINUTES=60
CPDA_NEWS_CRITICAL_MAX_AGE_MINUTES=240
CPDA_NEWS_URGENT_COOLDOWN_MINUTES=15
CPDA_NEWS_LATENCY_SLO_MS=3000
# --- Fast market watcher (EARLY WARNING only; never changes scores or scanner rules) ---
CPDA_FAST_ENABLED=true
CPDA_FAST_SEND_TELEGRAM=true
CPDA_FAST_MIN_QUOTE_VOLUME_USD=10000000
CPDA_FAST_SIGMA_K=4.0
CPDA_FAST_SIGMA_K_EXTREME=8.0
CPDA_FAST_MIN_PCT_1M=1.0
CPDA_FAST_MIN_PCT_3M=1.8
CPDA_FAST_MIN_PCT_5M=2.5
CPDA_FAST_VOLUME_EXPANSION=3.0
CPDA_FAST_COOLDOWN_MINUTES=30
# Liquidity: max bid/ask spread (percent, REST ticker); exclusions are recorded.
CPDA_FAST_MAX_SPREAD_PCT=0.15
# Early structural layer (EARLY WARNING only; never changes scores/thresholds).
# Distances are in ATR of the zone's reference timeframe (1H ATR for 1H/4H zones).
CPDA_EARLY_ENABLED=true
CPDA_EARLY_PATTERNS_ENABLED=true
CPDA_EARLY_ZONE_WATCH_ENABLED=true
CPDA_EARLY_SEND_TELEGRAM=true
CPDA_EARLY_ZONE_MIN_TOUCHES=2
CPDA_EARLY_APPROACH_ATR=0.35
CPDA_EARLY_BREAK_ATR=0.10
CPDA_EARLY_BREAK_HOLD_SECONDS=10
CPDA_EARLY_RETEST_ATR=0.25
CPDA_EARLY_FAIL_ATR=0.25
CPDA_EARLY_LATE_ORIGIN_ATR=3.0
CPDA_EARLY_IGNITION_MIN_STRENGTH=55
CPDA_EARLY_FORMATION_MIN_STRENGTH=50
CPDA_EARLY_COOLDOWN_MINUTES=120
# Notification policy (Telegram only). Every valid event is still persisted and
# measured for research; zone/formation/late events are research-only by default.
CPDA_EARLY_NOTIFY_ZONE_WATCH=false
CPDA_EARLY_NOTIFY_FORMATION=false
CPDA_EARLY_NOTIFY_APPROACH_ATR=0.20
CPDA_EARLY_NOTIFY_BUDGET_PER_5MIN=3
CPDA_EARLY_NOTIFY_BUDGET_PER_HOUR=12
CPDA_EARLY_CONTEXT_CONCURRENCY=3
CPDA_EARLY_PRIORITY_ANALYSES_PER_MINUTE=6
CPDA_EARLY_OUTCOME_HORIZON_MINUTES=240
# Setup expiry/lifecycle alerts between scans.
CPDA_LIFECYCLE_CHECK_SECONDS=15
CPDA_OI_COLLECTION_CONCURRENCY=5
# OI timestamps may be slightly ahead of this host's clock (measured ~80 ms). Only
# this much FUTURE skew is tolerated; staleness/boundary rules are unchanged.
# Keeping the host clock NTP-synced is still recommended.
CPDA_OI_CLOCK_SKEW_TOLERANCE_SECONDS=2.0
CPDA_BINGX_MARK_PRICE_WS_URL=wss://open-api-swap.bingx.com/swap-market
CPDA_BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
CPDA_SCANNER_WATCH_SCORE=60
CPDA_SCANNER_SETUP_SCORE=70
CPDA_SCANNER_HIGH_SCORE=80
CPDA_SCANNER_EXTREME_SCORE=90
CPDA_SCANNER_ALERT_SCORE=80
CPDA_SCANNER_COOLDOWN_MINUTES=60
CPDA_SCANNER_SCORE_DELTA=5
CPDA_SCANNER_SETUP_EXPIRY_MINUTES=240
CPDA_SCANNER_TELEGRAM_CHAT_ID=
CPDA_SCANNER_MIN_RR=1.5
CPDA_SCANNER_MAX_EXTENSION_ATR=3.0
CPDA_SCANNER_STOP_BUFFER_ATR=0.25
CPDA_SCANNER_ZONE_ATR=0.3
CPDA_SCANNER_LOCATION_ATR=1.0
CPDA_SCANNER_MACRO_PIVOT_LENGTH=5
CPDA_SCANNER_MICRO_PIVOT_LENGTH=2
CPDA_SCANNER_BREAK_REQUIRES_CLOSE=true
CPDA_SCANNER_EVENT_MAX_BARS=12
CPDA_SCANNER_RVOL_BASELINE=20
CPDA_SCANNER_RVOL_MIN=1.2
CPDA_SCANNER_ADX_MIN=20.0
CPDA_SCANNER_HIGH_VOLATILITY_ATR_PCT=4.0
CPDA_SCANNER_FUNDING_EXTREME=0.001
CPDA_SCANNER_USE_BTC_CONTEXT=true
CPDA_SCANNER_USE_DERIVATIVES=true
CPDA_FVG_MIN_ATR=0.15
# --- Research data collection (read-only; never trades) ---
CPDA_SCANNER_DRY_RUN=false
CPDA_SCANNER_SEND_TELEGRAM=true
# Setup-outcome horizon in closed bars of the setup timeframe (96 x 15m = 24h).
CPDA_OUTCOME_MAX_BARS_15M=96
CPDA_OUTCOME_MAX_BARS_1H=72
CPDA_OUTCOME_MAX_BARS_4H=42
# Resolve same-bar target/invalidation touches with complete lower-timeframe candles.
CPDA_OUTCOME_LTF_RESOLUTION=true
CPDA_CALIBRATION_BANDS=60,70,80,90
CPDA_CALIBRATION_MIN_SAMPLES=30
CPDA_TRADINGVIEW_WEBHOOK_ENABLED=false
CPDA_TRADINGVIEW_WEBHOOK_SECRET=

# Scanner alerts need CPDA_TELEGRAM_BOT_TOKEN and CPDA_SCANNER_TELEGRAM_CHAT_ID.
# Verify with: python -m app.telegram.smoke_test
# TradingView requires a secret of at least 24 characters when enabled. Events are stored only.
